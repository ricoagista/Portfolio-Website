              <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <span><strong class="text-indigo-600 dark:text-indigo-400">A →</strong> a</span>
                <span id="bfs-tag-A" class="text-xs text-slate-400">Pending</span>
              </div>
              <div id="bfs-rule-B" class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <span><strong class="text-indigo-600 dark:text-indigo-400">B →</strong> D | aa</span>
                <span id="bfs-tag-B" class="text-xs text-slate-400">Pending</span>
              </div>
              <div id="bfs-rule-D" class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between">
                <span><strong class="text-indigo-600 dark:text-indigo-400">D →</strong> d</span>
