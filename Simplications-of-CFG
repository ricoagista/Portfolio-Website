            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-2">Catatan Transformasi</span>
            <p id="e2e-log" class="text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              <!-- Populated by JS -->
            </p>
