        <!-- Right: Phase Tracker & Detailed Log -->
        <div class="lg:col-span-5 glass-card rounded-3xl p-6 flex flex-col justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-slate-400 block mb-3">Progres Fase Penyederhanaan</span>
            <div class="space-y-2 mb-6">
              <div id="e2e-pill-1" class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs font-bold">
                <span>Fase 1: Eliminasi λ-Productions</span>
                <span class="font-mono text-slate-400">Menunggu</span>
              </div>
              <div id="e2e-pill-2" class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs font-bold">
                <span>Fase 2: Eliminasi Unit Productions</span>
                <span class="font-mono text-slate-400">Menunggu</span>
              </div>
              <div id="e2e-pill-3" class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200 dark:border-slate-800 flex items-center justify-between text-xs font-bold">
                <span>Fase 3: Eliminasi Useless Symbols</span>
                <span class="font-mono text-slate-400">Menunggu</span>
