  </main>

  <!-- Bottom 3px Progress Bar & Minimal Counter -->
  <div class="fixed bottom-0 left-0 right-0 h-[3px] bg-slate-200/70 dark:bg-slate-800/80 z-50 pointer-events-none">
    <div id="progress-bar" class="h-full w-[14.28%] bg-gradient-to-r from-indigo-600 via-violet-500 to-emerald-500"></div>
  </div>
  <div id="slide-counter" class="fixed bottom-3 right-5 px-3 py-1 rounded-full glass-card font-mono text-xs font-bold text-slate-500 dark:text-slate-400 z-50 pointer-events-none">
    1 / 7
  </div>

  <script>
    // Initialize Lucide Icons & Register GSAP MotionPathPlugin
    lucide.createIcons();
    gsap.registerPlugin(MotionPathPlugin);

    // ==================== SLIDE NAVIGATION & THEME ====================
    const slides = document.querySelectorAll('.slide');
    const totalSlides = slides.length;
    let currentSlide = 0;

    function goToSlide(nextIndex) {
      if (nextIndex < 0 || nextIndex >= totalSlides || nextIndex === currentSlide) return;

      const outgoing = slides[currentSlide];
      const incoming = slides[nextIndex];
      const dir = nextIndex > currentSlide ? 1 : -1;
      currentSlide = nextIndex;

      gsap.to(outgoing, {
        opacity: 0,
        y: -24 * dir,
        scale: 0.98,
        duration: 0.32,
        ease: 'power2.in',
        onComplete: () => {
          outgoing.classList.remove('active');
        }
      });

      incoming.classList.add('active');
      gsap.fromTo(incoming,
        { opacity: 0, y: 28 * dir, scale: 0.98 },
        { opacity: 1, y: 0, scale: 1, duration: 0.45, ease: 'power3.out' }
      );

      document.getElementById('slide-counter').textContent = `${currentSlide + 1} / ${totalSlides}`;
      gsap.to('#progress-bar', {
        width: `${((currentSlide + 1) / totalSlides) * 100}%`,
        duration: 0.45,
        ease: 'power2.out'
      });
    }

    // Click empty area on deck to advance slide
    document.getElementById('deck').addEventListener('click', (e) => {
      if (e.target.closest('button')) return;
      if (currentSlide < totalSlides - 1) {
        goToSlide(currentSlide + 1);
      }
    });

    // Keyboard shortcuts
    document.addEventListener('keydown', (e) => {
      if (['ArrowRight', 'Space', ' ', 'PageDown'].includes(e.key)) {
        e.preventDefault();
        goToSlide(currentSlide + 1);
      } else if (['ArrowLeft', 'Backspace', 'PageUp'].includes(e.key)) {
        e.preventDefault();
        goToSlide(currentSlide - 1);
      } else if (e.key.toLowerCase() === 'f') {
        toggleFullscreen();
      } else if (e.key.toLowerCase() === 't') {
        toggleTheme();
      }
    });

    function toggleTheme() {
      document.documentElement.classList.toggle('dark');
    }

    function toggleFullscreen() {
      if (!document.fullscreenElement) {
        document.documentElement.requestFullscreen().catch(() => {});
      } else {
        document.exitFullscreen().catch(() => {});
      }
    }

    // ==================== SLIDE 1: AMBIENT & KINETIC ENTRANCE ====================
    function initSlide1Animations() {
      gsap.from('.hero-stagger', {
        y: 26,
        opacity: 0,
        duration: 0.75,
        stagger: 0.12,
        ease: 'power3.out'
      });

      const nodes = Array.from(document.querySelectorAll('#hero-constellation .const-node'));
      const lines = Array.from(document.querySelectorAll('#hero-constellation .const-line path'));
      const links = [[0, 1], [0, 2], [1, 3], [1, 4], [2, 5], [2, 6]];

      // Latar opak di belakang node kotak (fill-nya transparan) supaya garis tidak tembus
      nodes.forEach(n => {
        const rect = n.querySelector('rect');
        if (!rect) return;
        const back = rect.cloneNode();
        back.setAttribute('class', 'fill-slate-50 dark:fill-slate-950');
        back.removeAttribute('stroke');
        n.insertBefore(back, rect);
      });

      // Garis selalu menempel ke posisi node yang sedang melayang
      const syncLines = () => {
        links.forEach(([i, j], k) => {
          const x1 = gsap.getProperty(nodes[i], 'x'), y1 = gsap.getProperty(nodes[i], 'y');
          const x2 = gsap.getProperty(nodes[j], 'x'), y2 = gsap.getProperty(nodes[j], 'y');
          lines[k].setAttribute('d', `M ${x1} ${y1} L ${x2} ${y2}`);
        });
      };
      syncLines();
      gsap.ticker.add(syncLines);

      gsap.to('.const-node', {
        y: '+=8',
        duration: 2.6,
        repeat: -1,
        yoyo: true,
        ease: 'sine.inOut',
        stagger: { each: 0.25, from: 'random' }
      });

      gsap.to('.const-line path', {
        strokeDashoffset: -24,
        duration: 1.8,
        repeat: -1,
        ease: 'none'
      });
    }

    // ==================== SLIDE 2: EFEK DOMINO PIPELINE ====================
    let dominoTl = null;
    function runDominoSimulation() {
      if (dominoTl) dominoTl.kill();
      resetDominoVisuals();

      const btn = document.getElementById('btn-domino');
      btn.disabled = true;
      btn.classList.add('opacity-60');

      dominoTl = gsap.timeline({
        onComplete: () => {
          btn.disabled = false;
          btn.classList.remove('opacity-60');
          document.getElementById('btn-domino-reset').classList.remove('hidden');
        }
      });

      dominoTl
        .to('#dom-card-1', { borderColor: '#F43F5E', y: -6, boxShadow: '0 16px 32px -10px rgba(244,63,94,0.28)', duration: 0.35 })
        .to('#dom-energy-bar', { width: '36%', duration: 0.45, ease: 'power2.out' })
        .to('#dom-card-2', { opacity: 1, borderColor: '#4F46E5', y: -6, boxShadow: '0 16px 32px -10px rgba(79,70,229,0.28)', duration: 0.35 })
        .to('#dom-energy-bar', { width: '70%', duration: 0.45, ease: 'power2.out' })
        .to('#dom-card-3', { opacity: 1, borderColor: '#10B981', y: -6, boxShadow: '0 16px 32px -10px rgba(16,185,129,0.28)', duration: 0.35 })
        .to('#dom-energy-bar', { width: '100%', duration: 0.45, ease: 'power2.out' })
        .to('#dom-warning', { opacity: 1, scale: 1.01, duration: 0.35, yoyo: true, repeat: 1 });
    }

    function resetDominoVisuals() {
      gsap.set(['#dom-card-1', '#dom-card-2', '#dom-card-3'], { clearProps: 'all' });
      document.getElementById('dom-card-2').classList.add('opacity-50');
      document.getElementById('dom-card-3').classList.add('opacity-50');
      gsap.set('#dom-energy-bar', { width: '0%' });
    }

    function resetDominoSimulation() {
      if (dominoTl) dominoTl.kill();
      resetDominoVisuals();
      document.getElementById('btn-domino-reset').classList.add('hidden');
    }

    // ==================== SLIDE 3: ELIMINASI LAMBDA-PRODUCTIONS ====================
    let lamStep = 0;
    function nextLambdaStep() {
      lamStep++;
      const btn = document.getElementById('btn-lam-step');
      const log = document.getElementById('lam-log');

      if (lamStep === 1) {
        document.getElementById('nullable-placeholder').classList.add('hidden');
        ['nb-token-A', 'nb-token-B', 'nb-token-S'].forEach(id => {
          document.getElementById(id).classList.remove('hidden');
        });
        gsap.from(['#nb-token-A', '#nb-token-B', '#nb-token-S'], {
          scale: 0.4,
          y: -25,
          opacity: 0,
          duration: 0.45,
          stagger: 0.14,
          ease: 'back.out(1.7)'
        });

        document.getElementById('lam-a-lam').classList.add('!bg-amber-500/20', '!text-amber-600', 'dark:!text-amber-400', '!border-amber-500/40');
        document.getElementById('lam-b-lam').classList.add('!bg-amber-500/20', '!text-amber-600', 'dark:!text-amber-400', '!border-amber-500/40');

        document.getElementById('lam-ind-1').classList.replace('text-slate-400', 'text-amber-500');
        log.innerHTML = '<strong>Langkah 1:</strong> Variabel <span class="font-mono font-bold text-amber-500">A</span> dan <span class="font-mono font-bold text-amber-500">B</span> menurunkan <span class="font-mono">λ</span> secara langsung, sedangkan <span class="font-mono font-bold text-indigo-500">S → AB</span> bersifat nullable secara tidak langsung.';
        btn.innerHTML = '<i data-lucide="play" class="w-4 h-4"></i><span>Langkah 2: Pecah Kombinasi</span>';
        lucide.createIcons();
      } else if (lamStep === 2) {
        const newPills = ['lam-s-comb1', 'lam-s-comb2', 'lam-s-comb3', 'lam-a-new', 'lam-b-new'];
        newPills.forEach(id => document.getElementById(id).classList.remove('hidden'));
        gsap.from(newPills.map(id => `#${id}`), {
          scale: 0.7,
          opacity: 0,
          duration: 0.4,
          stagger: 0.08,
          ease: 'back.out(1.6)'
        });

        document.getElementById('lam-ind-2').classList.replace('text-slate-400', 'text-emerald-500');
        log.innerHTML = '<strong>Langkah 2:</strong> Aturan <span class="font-mono">S → AB</span> dipecah menjadi seluruh kombinasi <span class="font-mono text-emerald-500 font-bold">AB | A | B</span> (tanpa <span class="font-mono">S → λ</span>). Demikian pula <span class="font-mono">A → aA | a</span> dan <span class="font-mono">B → bB | b</span>.';
        btn.innerHTML = '<i data-lucide="trash-2" class="w-4 h-4"></i><span>Langkah 3: Hapus Aturan λ</span>';
        btn.classList.replace('bg-indigo-600', 'bg-rose-600');
        btn.classList.replace('hover:bg-indigo-700', 'hover:bg-rose-700');
        lucide.createIcons();
      } else if (lamStep === 3) {
        const targets = ['#lam-a-lam', '#lam-b-lam', '#lam-s-comb3'];
        targets.forEach(sel => {
          const el = document.querySelector(sel);
          el.classList.add('line-through', '!bg-rose-500/15', '!text-rose-500', '!border-rose-500/30');
        });
        gsap.to(targets, {
          opacity: 0.35,
          scale: 0.92,
          duration: 0.45,
          ease: 'power2.out'
        });

        document.getElementById('lam-ind-3').classList.replace('text-slate-400', 'text-rose-500');
        log.innerHTML = '<strong class="text-emerald-600 dark:text-emerald-400">Tahap 1 Selesai!</strong> Seluruh produksi <span class="font-mono">→ λ</span> telah dicoret dan dieliminasi. Perhatikan munculnya unit production baru <span class="font-mono font-bold text-indigo-500">S → A | B</span>!';
        btn.classList.add('hidden');
        document.getElementById('btn-lam-reset').classList.remove('hidden');
      }
    }

    function resetLambdaStep() {
      lamStep = 0;
      document.getElementById('nullable-placeholder').classList.remove('hidden');
      ['nb-token-A', 'nb-token-B', 'nb-token-S'].forEach(id => {
        const el = document.getElementById(id);
        el.classList.add('hidden');
        gsap.set(el, { clearProps: 'all' });
      });

      ['lam-s-comb1', 'lam-s-comb2', 'lam-s-comb3', 'lam-a-new', 'lam-b-new'].forEach(id => {
        const el = document.getElementById(id);
        el.classList.add('hidden');
        el.classList.remove('line-through', 'opacity-35');
        gsap.set(el, { clearProps: 'all' });
      });

      ['lam-a-lam', 'lam-b-lam'].forEach(id => {
        const el = document.getElementById(id);
        el.className = 'rule-pill bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700';
        gsap.set(el, { clearProps: 'all' });
      });

      ['lam-ind-1', 'lam-ind-2', 'lam-ind-3'].forEach(id => {
        const el = document.getElementById(id);
        el.className = 'py-1.5 rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-400 font-bold';
      });

      const btn = document.getElementById('btn-lam-step');
      btn.className = 'inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-lg shadow-indigo-500/25 hover:-translate-y-0.5 active:scale-95 transition-all cursor-pointer';
      btn.innerHTML = '<i data-lucide="play" class="w-4 h-4"></i><span>Langkah 1: Deteksi Nullable</span>';
      document.getElementById('btn-lam-reset').classList.add('hidden');
      document.getElementById('lam-log').innerHTML = 'Klik <strong>"Langkah 1: Deteksi Nullable"</strong> untuk mengidentifikasi variabel yang dapat menurunkan string kosong <span class="font-mono">λ</span> baik secara langsung maupun tidak langsung.';
      lucide.createIcons();
    }

    // ==================== SLIDE 4: UNIT PRODUCTIONS MOTIONPATH ====================
    let unitTl = null;
    function runUnitMotionPath() {
      if (unitTl) unitTl.kill();
      resetUnitVisuals();

      const btn = document.getElementById('btn-unit-run');
      const log = document.getElementById('u-log');
      btn.disabled = true;
      btn.classList.add('opacity-60');

      const packet = document.getElementById('u-packet');
      gsap.set(packet, { opacity: 1, x: 490, y: 115 });

      unitTl = gsap.timeline({
        onComplete: () => {
          gsap.to(packet, { opacity: 0, duration: 0.3 });
          btn.disabled = false;
          btn.classList.remove('opacity-60');
          document.getElementById('btn-unit-reset').classList.remove('hidden');
          log.innerHTML = '<strong class="text-emerald-600 dark:text-emerald-400">Propagasi Selesai!</strong> Seluruh panah unit <span class="font-mono text-rose-500">S → A → B → C</span> terputus dan digantikan produksi terminal langsung.';
        }
      });

      unitTl
        // Hop 1: C -> B
        .add(() => { log.innerHTML = 'Paket terminal <span class="font-mono font-bold text-emerald-500">c</span> bergerak dari <strong>C → B</strong>...'; })
        .to(packet, {
          motionPath: { path: '#rev-CB', align: '#rev-CB', alignOrigin: [0.5, 0.5] },
          duration: 0.75,
          ease: 'power2.inOut'
        })
        .add(() => {
          document.getElementById('u-badge-text-B').textContent = 'b | c';
          document.getElementById('ur-B-old').classList.add('line-through', 'opacity-40');
          document.getElementById('ur-B-new').classList.remove('hidden');
        })
        .to(['#u-path-BC', '#u-lbl-BC'], { opacity: 0.15, strokeDasharray: '5 5', duration: 0.3 })

        // Hop 2: B -> A
        .add(() => { log.innerHTML = 'Paket gabungan <span class="font-mono font-bold text-emerald-500">b | c</span> bergerak dari <strong>B → A</strong>...'; })
        .to(packet, {
          motionPath: { path: '#rev-BA', align: '#rev-BA', alignOrigin: [0.5, 0.5] },
          duration: 0.75,
          ease: 'power2.inOut'
        })
        .to('#u-badge-A', { opacity: 1, y: 0, duration: 0.35 })
        .add(() => {
          document.getElementById('ur-A-old').classList.add('line-through', 'opacity-40');
          document.getElementById('ur-A-new').classList.remove('hidden');
        })
        .to(['#u-path-AB', '#u-lbl-AB'], { opacity: 0.15, strokeDasharray: '5 5', duration: 0.3 })

        // Hop 3: A -> S
        .add(() => { log.innerHTML = 'Paket <span class="font-mono font-bold text-emerald-500">b | c</span> diteruskan dari <strong>A → S</strong>...'; })
        .to(packet, {
          motionPath: { path: '#rev-AS', align: '#rev-AS', alignOrigin: [0.5, 0.5] },
          duration: 0.75,
          ease: 'power2.inOut'
        })
        .to('#u-badge-S', { opacity: 1, y: 0, duration: 0.35 })
        .add(() => {
          document.getElementById('ur-S-old').classList.add('line-through', 'opacity-40');
          document.getElementById('ur-S-new').classList.remove('hidden');
        })
        .to(['#u-path-SA', '#u-lbl-SA'], { opacity: 0.15, strokeDasharray: '5 5', duration: 0.3 });
    }

    function resetUnitVisuals() {
      gsap.set('#u-packet', { opacity: 0 });
      gsap.set(['#u-path-SA', '#u-lbl-SA', '#u-path-AB', '#u-lbl-AB', '#u-path-BC', '#u-lbl-BC'], { opacity: 1, strokeDasharray: 'none' });
      gsap.set(['#u-badge-A', '#u-badge-S'], { opacity: 0 });
      document.getElementById('u-badge-text-B').textContent = 'b';
      ['S', 'A', 'B'].forEach(v => {
        document.getElementById(`ur-${v}-old`).classList.remove('line-through', 'opacity-40');
        document.getElementById(`ur-${v}-new`).classList.add('hidden');
      });
    }

    function resetUnitMotionPath() {
      if (unitTl) unitTl.kill();
      resetUnitVisuals();
      document.getElementById('btn-unit-reset').classList.add('hidden');
      document.getElementById('u-log').innerHTML = 'Klik <strong>"Jalankan Propagasi Node"</strong> untuk melihat bola cahaya menyalin produksi terminal dari <span class="font-mono font-bold">C → B → A → S</span>.';
    }

    // ==================== SLIDE 5: NON-GENERATING VARIABLES ====================
    let genTl = null;
    function runGeneratingTest() {
      if (genTl) genTl.kill();
      resetGeneratingVisuals();

      const btn = document.getElementById('btn-gen-run');
      const log = document.getElementById('gen-log');
      const setDisplay = document.getElementById('gen-set-display');
      btn.disabled = true;
      btn.classList.add('opacity-60');

      genTl = gsap.timeline({
        onComplete: () => {
          btn.disabled = false;
          btn.classList.remove('opacity-60');
          document.getElementById('btn-gen-reset').classList.remove('hidden');
        }
      });

      genTl
        // Step 1: A and B light up green
        .to(['#gcard-A', '#gcard-B'], {
          borderColor: '#10B981',
          backgroundColor: 'rgba(16, 185, 129, 0.12)',
          scale: 1.04,
          duration: 0.4,
          stagger: 0.15
        })
        .add(() => {
          document.getElementById('gstat-A').innerHTML = '<span class="text-emerald-500 font-bold">✓ a ∈ T*</span>';
          document.getElementById('gstat-B').innerHTML = '<span class="text-emerald-500 font-bold">✓ aa ∈ T*</span>';
          setDisplay.textContent = 'V_G = { A, B }';
          setDisplay.classList.replace('text-slate-400', 'text-emerald-500');
          log.innerHTML = '<strong>Iterasi 1:</strong> <span class="font-mono font-bold">A → a</span> dan <span class="font-mono font-bold">B → aa</span> langsung menghasilkan terminal murni.';
        })
        .to(['#gcard-A', '#gcard-B'], { scale: 1, duration: 0.25 })

        // Step 2: S receives signal from A and turns green
        .to('#gcard-S', {
          borderColor: '#10B981',
          backgroundColor: 'rgba(16, 185, 129, 0.12)',
          scale: 1.04,
          duration: 0.4
        }, '+=0.3')
        .add(() => {
          document.getElementById('gstat-S').innerHTML = '<span class="text-emerald-500 font-bold">✓ via A</span>';
          setDisplay.textContent = 'V_G = { A, B, S }';
          log.innerHTML = '<strong>Iterasi 2:</strong> Karena <span class="font-mono font-bold">S → A</span> dan <span class="font-mono">A ∈ V_G</span>, maka <span class="font-mono font-bold text-emerald-500">S</span> ikut bersifat generating.';
        })
        .to('#gcard-S', { scale: 1, duration: 0.25 })

        // Step 3: C shakes red and gets eliminated
        .to('#gcard-C', {
          borderColor: '#F43F5E',
          backgroundColor: 'rgba(244, 63, 94, 0.14)',
          duration: 0.25
        }, '+=0.3')
        .to('#gcard-C', {
          x: -6,
          duration: 0.07,
          repeat: 5,
          yoyo: true,
          ease: 'sine.inOut'
        })
        .add(() => {
          document.getElementById('gstat-C').innerHTML = '<span class="text-rose-500 font-bold">✕ Infinite Loop</span>';
          document.getElementById('gr-S-C').classList.add('line-through', '!bg-rose-500/15', '!text-rose-500');
          log.innerHTML = '<strong class="text-rose-500">Variabel C Dieliminasi!</strong> Aturan <span class="font-mono">C → aCb</span> tidak pernah mencapai terminal, sehingga node <span class="font-mono font-bold">C</span> dan cabang <span class="font-mono">| C</span> pada <span class="font-mono">S</span> dihapus.';
        })
        .to(['#gcard-C', '#gr-row-C'], {
          opacity: 0.32,
          scale: 0.96,
          duration: 0.45
        }, '+=0.35');
    }

    function resetGeneratingVisuals() {
      ['S', 'A', 'B', 'C'].forEach(v => {
        gsap.set(`#gcard-${v}`, { clearProps: 'all' });
        document.getElementById(`gstat-${v}`).textContent = 'Menunggu...';
      });
      gsap.set('#gr-row-C', { clearProps: 'all' });
      document.getElementById('gr-S-C').className = 'rule-pill bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700';
      const setDisplay = document.getElementById('gen-set-display');
      setDisplay.textContent = 'V_G = { ? }';
      setDisplay.className = 'p-4 rounded-2xl bg-slate-100/90 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 font-mono text-lg font-bold text-slate-400 mb-5';
    }

    function resetGeneratingTest() {
      if (genTl) genTl.kill();
      resetGeneratingVisuals();
      document.getElementById('btn-gen-reset').classList.add('hidden');
      document.getElementById('gen-log').innerHTML = 'Klik <strong>"Uji Variabel Generating"</strong> untuk melihat iterasi penemuan simbol penghasil terminal (<span class="font-mono">A</span> dan <span class="font-mono">B</span>), propagasi ke <span class="font-mono">S</span>, serta eliminasi <span class="font-mono">C</span>.';
    }

    // ==================== SLIDE 6: UNREACHABLE SYMBOLS (BFS RADAR) ====================
    let bfsTl = null;
    function runBfsRadar() {
      if (bfsTl) bfsTl.kill();
      resetBfsVisuals();

      const btn = document.getElementById('btn-bfs-run');
      const log = document.getElementById('bfs-log');
      btn.disabled = true;
      btn.classList.add('opacity-60');

      bfsTl = gsap.timeline({
        onComplete: () => {
          btn.disabled = false;
          btn.classList.remove('opacity-60');
          document.getElementById('btn-bfs-reset').classList.remove('hidden');
        }
      });

      bfsTl
        // Pulse 1 at S
        .set('#radar-S', { r: 26, opacity: 0.9 })
        .to('#radar-S', { r: 62, opacity: 0, duration: 0.75, ease: 'power2.out' })
        .add(() => {
          document.getElementById('bfs-circ-S').setAttribute('stroke', '#10B981');
          document.getElementById('bfs-loop-S').setAttribute('stroke', '#10B981');
          document.getElementById('bfs-tag-S').innerHTML = '<span class="text-emerald-500 font-bold">✓ Reachable</span>';
          log.innerHTML = '<strong>Gelombang 1:</strong> Memulai penelusuran BFS dari simbol awal <span class="font-mono font-bold text-emerald-500">S</span>...';
        }, '<')

        // Travel S -> A & Pulse 2 at A
        .add(() => {
          const eSA = document.getElementById('bfs-edge-SA');
          eSA.setAttribute('stroke', '#10B981');
          eSA.setAttribute('marker-end', 'url(#bfs-arr-em)');
        })
        .set('#radar-A', { r: 26, opacity: 0.9 })
        .to('#radar-A', { r: 62, opacity: 0, duration: 0.75, ease: 'power2.out' })
        .add(() => {
          document.getElementById('bfs-circ-A').setAttribute('stroke', '#10B981');
          const eAa = document.getElementById('bfs-edge-Aa');
          eAa.setAttribute('stroke', '#10B981');
          eAa.setAttribute('marker-end', 'url(#bfs-arr-em)');
          document.getElementById('bfs-rect-a').setAttribute('stroke', '#10B981');
          document.getElementById('bfs-tag-A').innerHTML = '<span class="text-emerald-500 font-bold">✓ Reachable</span>';
          log.innerHTML = '<strong>Gelombang 2:</strong> Node <span class="font-mono font-bold text-emerald-500">A</span> dan terminal <span class="font-mono font-bold text-emerald-500">a</span> terjangkau dari <span class="font-mono">S</span>.';
        }, '<')

        // Cut isolated subgraph {B, D}
        .to('#bfs-isolated-group', {
          opacity: 0.22,
          y: 8,
          duration: 0.55,
          ease: 'power2.out'
        }, '+=0.25')
        .to(['#bfs-rule-B', '#bfs-rule-D'], {
          opacity: 0.35,
          duration: 0.4
        }, '<')
        .add(() => {
          document.getElementById('bfs-iso-tag').textContent = 'UNREACHABLE!';
          document.getElementById('bfs-iso-tag').setAttribute('fill', '#F43F5E');
          document.getElementById('bfs-rule-B').classList.add('line-through');
          document.getElementById('bfs-rule-D').classList.add('line-through');
          document.getElementById('bfs-tag-B').innerHTML = '<span class="text-rose-500 font-bold">✕ Terpotong</span>';
          document.getElementById('bfs-tag-D').innerHTML = '<span class="text-rose-500 font-bold">✕ Terpotong</span>';
          log.innerHTML = '<strong class="text-emerald-600 dark:text-emerald-400">Penyederhanaan Tuntas!</strong> Subgraf <span class="font-mono font-bold text-rose-500">{B, D}</span> tidak tersentuh gelombang dari <span class="font-mono">S</span> dan resmi dihapus.';
        }, '<');
    }

    function resetBfsVisuals() {
      gsap.set(['#radar-S', '#radar-A'], { opacity: 0, r: 26 });
      gsap.set('#bfs-isolated-group', { clearProps: 'all' });
      gsap.set(['#bfs-rule-B', '#bfs-rule-D'], { clearProps: 'all' });

      document.getElementById('bfs-circ-S').setAttribute('stroke', '#4F46E5');
      document.getElementById('bfs-circ-A').setAttribute('stroke', '#64748B');
      document.getElementById('bfs-rect-a').setAttribute('stroke', '#64748B');
      document.getElementById('bfs-loop-S').setAttribute('stroke', '#64748B');

      ['bfs-edge-SA', 'bfs-edge-Aa'].forEach(id => {
        const el = document.getElementById(id);
        el.setAttribute('stroke', '#64748B');
        el.setAttribute('marker-end', 'url(#bfs-arr)');
      });

      document.getElementById('bfs-iso-tag').textContent = 'Tanpa jalur masuk';
      document.getElementById('bfs-iso-tag').setAttribute('fill', '#64748B');
      document.getElementById('bfs-rule-B').classList.remove('line-through');
      document.getElementById('bfs-rule-D').classList.remove('line-through');

      document.getElementById('bfs-tag-S').textContent = 'Start';
      document.getElementById('bfs-tag-A').textContent = 'Pending';
      document.getElementById('bfs-tag-B').textContent = 'Pending';
      document.getElementById('bfs-tag-D').textContent = 'Pending';
    }

    function resetBfsRadar() {
      if (bfsTl) bfsTl.kill();
      resetBfsVisuals();
      document.getElementById('btn-bfs-reset').classList.add('hidden');
      document.getElementById('bfs-log').innerHTML = 'Klik <strong>"Jalankan Gelombang BFS dari S"</strong> untuk memancarkan gelombang keterjangkauan dan memangkas subgraf terisolasi <span class="font-mono font-bold">{B, D}</span>.';
    }

    // ==================== SLIDE 7: END-TO-END CASE STUDY ====================
    // Pola animasi sama dengan Slide 3: aturan baru "pop" masuk (hijau),
    // aturan yang gugur dicoret merah lalu memudar, bukan render ulang seluruh kartu.
    const PILL_BASE = 'rule-pill border whitespace-nowrap overflow-hidden ';
    const PILL_STATE = {
      neutral:  'bg-white dark:bg-slate-800 border-slate-200 dark:border-slate-700',
      nullable: 'bg-amber-500/15 text-amber-600 dark:text-amber-400 border-amber-500/30',
      fresh:    'bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 border-emerald-500/30',
      warn:     'bg-rose-500/10 text-rose-500 border-rose-500/30',
      dead:     'bg-rose-500/15 text-rose-500 border-rose-500/30 line-through'
    };

    // add = fase kemunculan, rem = fase penghapusan, first = tanpa prefix "|"
    const e2eRows = [
      { lhs: 'S', tokens: [
        { t: 'ABaC', first: true },
        { t: 'AaC', add: 1 }, { t: 'BaC', add: 1 }, { t: 'ABa', add: 1 }, { t: 'aC', add: 1 },
        { t: 'Aa', add: 1 }, { t: 'Ba', add: 1 }, { t: 'a', add: 1 }
      ]},
      { lhs: 'A', tokens: [
        { t: 'BC', first: true },
        { t: 'B', add: 1, rem: 2 }, { t: 'C', add: 1, rem: 2 },
        { t: 'b', add: 2 }, { t: 'd', add: 2 }
      ]},
      { lhs: 'B', tokens: [
        { t: 'b', first: true },
        { t: 'λ', nullable: true, rem: 1 }
      ]},
      { lhs: 'C', tokens: [
        { t: 'D', first: true, rem: 2 },
        { t: 'd', first: true, add: 2 },
        { t: 'λ', nullable: true, rem: 1 }
      ]},
      { lhs: 'D', rem: 3, unreachableAt: 2, tokens: [
        { t: 'd', first: true, rem: 3 }
      ]}
    ];

    const e2eData = [
      {
        badge: 'Kondisi Awal: Tata Bahasa G',
        btnHtml: '<i data-lucide="play" class="w-4 h-4"></i><span>Jalankan Fase 1: Hapus λ</span>',
        btnColor: 'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/25',
        log: 'Tata bahasa awal mengandung variabel <em>nullable</em> <span class="font-mono font-bold text-amber-500">{B, C, A}</span> (karena <span class="font-mono">A → BC ⇒* λ</span>), aturan unit <span class="font-mono">C → D</span>, dan variabel yang berpotensi terisolasi.'
      },
      {
        badge: 'Fase 1 Selesai: Bebas λ-Productions',
        btnHtml: '<i data-lucide="play" class="w-4 h-4"></i><span>Jalankan Fase 2: Hapus Unit</span>',
        btnColor: 'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/25',
        log: 'Aturan <span class="font-mono">B → λ</span> dan <span class="font-mono">C → λ</span> dihapus. Ekspansi <span class="font-mono">A → BC</span> melahirkan aturan unit baru <span class="font-mono font-bold text-emerald-500">A → B</span> dan <span class="font-mono font-bold text-emerald-500">A → C</span>!'
      },
      {
        badge: 'Fase 2 Selesai: Bebas Unit Productions',
        btnHtml: '<i data-lucide="play" class="w-4 h-4"></i><span>Jalankan Fase 3: Hapus Useless</span>',
        btnColor: 'bg-indigo-600 hover:bg-indigo-700 shadow-indigo-500/25',
        log: 'Rantai unit <span class="font-mono">A → B → b</span> dan <span class="font-mono">A → C → D → d</span> disubstitusi langsung. Akibatnya, variabel <span class="font-mono font-bold text-rose-500">D</span> terputus dari simbol awal <span class="font-mono">S</span>.'
      },
      {
        badge: 'Fase 3 Selesai: Grammar Bersih (Siap ke CNF)',
        btnHtml: '<i data-lucide="rotate-ccw" class="w-4 h-4"></i><span>Ulangi Studi Kasus</span>',
        btnColor: 'bg-emerald-600 hover:bg-emerald-700 shadow-emerald-500/25',
        log: '<strong class="text-emerald-600 dark:text-emerald-400">Penyederhanaan Selesai!</strong> Variabel unreachable <span class="font-mono">D</span> dihapus. Tata bahasa kini bebas dari <span class="font-mono">λ</span>, unit, dan useless productions sehingga siap menuju <strong>Chomsky Normal Form (CNF)</strong>.'
      }
    ];

    let e2ePhase = 0;
    let e2eBusy = false;
    let e2eTl = null;

    function setPillState(tok, state) {
      tok.state = state;
      tok.el.className = PILL_BASE + PILL_STATE[state];
    }

    function buildEndToEnd() {
      const container = document.getElementById('e2e-cards');
      container.innerHTML = '';
      e2eRows.forEach(row => {
        const rowEl = document.createElement('div');
        rowEl.className = 'e2e-rule-card p-3.5 rounded-2xl bg-slate-100/85 dark:bg-slate-900/85 border border-slate-200 dark:border-slate-800 flex flex-wrap items-center gap-2 overflow-hidden';

        const lhs = document.createElement('span');
        lhs.className = 'font-bold text-indigo-600 dark:text-indigo-400 min-w-[2.5rem] mr-1';
        lhs.textContent = row.lhs + ' →';
        rowEl.appendChild(lhs);

        row.tokens.forEach(tok => {
          tok.el = document.createElement('span');
          tok.el.textContent = (tok.first ? '' : '| ') + tok.t;
          setPillState(tok, tok.nullable ? 'nullable' : 'neutral');
          if (tok.add) tok.el.style.display = 'none';
          rowEl.appendChild(tok.el);
        });

        if (row.unreachableAt) {
          row.tagEl = document.createElement('span');
          row.tagEl.className = 'ml-auto text-xs font-bold text-rose-500 whitespace-nowrap';
          row.tagEl.textContent = 'Unreachable dari S!';
          row.tagEl.style.display = 'none';
          rowEl.appendChild(row.tagEl);
        }

        row.el = rowEl;
        container.appendChild(rowEl);
      });
    }

    function setE2eText(phase, animate) {
      const data = e2eData[phase];
      const badge = document.getElementById('e2e-badge');
      const log = document.getElementById('e2e-log');
      const apply = () => { badge.textContent = data.badge; log.innerHTML = data.log; };
      if (!animate) { apply(); return; }
      gsap.to([badge, log], {
        opacity: 0, duration: 0.15,
        onComplete: () => { apply(); gsap.to([badge, log], { opacity: 1, duration: 0.35, ease: 'power2.out' }); }
      });
    }

    function setE2eButton(phase) {
      const data = e2eData[phase];
      const btn = document.getElementById('btn-e2e-step');
      btn.className = `inline-flex items-center gap-2 px-4 py-2 rounded-xl ${data.btnColor} text-white font-bold text-sm shadow-lg hover:-translate-y-0.5 active:scale-95 transition-all cursor-pointer`;
      btn.innerHTML = data.btnHtml;
      lucide.createIcons();
    }

    function setPhasePill(i, status) {
      const pill = document.getElementById(`e2e-pill-${i}`);
      const span = pill.querySelector('span:last-child');
      const base = 'p-3 rounded-xl border flex items-center justify-between text-xs font-bold transition-colors duration-300 ';
      if (status === 'done') {
        pill.className = base + 'bg-emerald-500/10 border-emerald-500/40';
        span.textContent = '✓ Selesai';
        span.className = 'font-mono text-emerald-500 font-bold';
        gsap.fromTo(pill, { scale: 0.97 }, { scale: 1, duration: 0.35, ease: 'back.out(2)' });
      } else if (status === 'running') {
        pill.className = base + 'bg-amber-500/10 border-amber-500/40';
        span.textContent = 'Berjalan…';
        span.className = 'font-mono text-amber-500 font-bold';
      } else {
        pill.className = base + 'bg-slate-100/80 dark:bg-slate-900/80 border-slate-200 dark:border-slate-800';
        span.textContent = 'Menunggu';
        span.className = 'font-mono text-slate-400';
      }
    }

    function runEndToEndPhase(p) {
      e2eBusy = true;
      const btn = document.getElementById('btn-e2e-step');
      btn.disabled = true;
      btn.classList.add('opacity-60');
      setPhasePill(p, 'running');

      const adds = [], rems = [], rowsToDrop = [], tags = [];
      e2eRows.forEach(row => {
        if (row.rem === p) rowsToDrop.push(row);
        if (row.unreachableAt === p) tags.push(row);
        row.tokens.forEach(tok => {
          if (tok.add === p) adds.push(tok);
          if (tok.rem === p) rems.push(tok);
        });
      });
      const pillsToCollapse = rems.filter(tok => !rowsToDrop.some(r => r.tokens.includes(tok)));

      e2eTl = gsap.timeline({
        onComplete: () => {
          setPhasePill(p, 'done');
          e2ePhase = p;
          setE2eButton(p);
          btn.disabled = false;
          btn.classList.remove('opacity-60');
          e2eBusy = false;
        }
      });

      // 0. Ganti badge + log, redupkan warna hijau fase sebelumnya
      e2eTl.add(() => {
        setE2eText(p, true);
        e2eRows.forEach(r => r.tokens.forEach(t => { if (t.state === 'fresh') setPillState(t, 'neutral'); }));
      });

      // 1. Aturan baru muncul (pop, hijau) -- seperti "Langkah 2" di slide 3
      if (adds.length) {
        e2eTl.add(() => {
          adds.forEach(t => { t.el.style.display = ''; setPillState(t, 'fresh'); });
          gsap.set(adds.map(t => t.el), { opacity: 0, scale: 0.7 });
        }, '+=0.3');
        e2eTl.to(adds.map(t => t.el), {
          opacity: 1, scale: 1, duration: 0.4, stagger: 0.08, ease: 'back.out(1.6)'
        });
      }

      // 2. Aturan yang gugur dicoret merah lalu meredup -- seperti "Langkah 3" di slide 3
      if (rems.length) {
        e2eTl.add(() => rems.forEach(t => setPillState(t, 'dead')), '+=0.35');
        e2eTl.to(rems.map(t => t.el), { opacity: 0.35, scale: 0.92, duration: 0.45, ease: 'power2.out' });
      }

      // 3a. Penanda variabel tak terjangkau (fase 2)
      tags.forEach(row => {
        e2eTl.add(() => {
          row.tokens.forEach(t => setPillState(t, 'warn'));
          row.tagEl.style.display = '';
          gsap.set(row.tagEl, { opacity: 0, scale: 0.7 });
        }, '+=0.3');
        e2eTl.to(row.tagEl, { opacity: 1, scale: 1, duration: 0.4, ease: 'back.out(1.6)' });
      });

      // 3b. Pill yang dicoret menyusut halus sampai hilang
      if (pillsToCollapse.length) {
        e2eTl.to(pillsToCollapse.map(t => t.el), {
          opacity: 0, scale: 0.6, width: 0, paddingLeft: 0, paddingRight: 0, marginLeft: -8, borderWidth: 0,
          duration: 0.45, ease: 'power2.in'
        }, '+=0.5');
        e2eTl.add(() => pillsToCollapse.forEach(t => { t.el.style.display = 'none'; }));
      }

      // 3c. Baris variabel yang sepenuhnya useless (D) menutup
      if (rowsToDrop.length) {
        const rowEls = rowsToDrop.map(r => r.el);
        e2eTl.to(rowEls, {
          opacity: 0, height: 0, paddingTop: 0, paddingBottom: 0, marginTop: 0, borderWidth: 0,
          duration: 0.55, ease: 'power2.inOut'
        }, '+=0.5');
        e2eTl.add(() => rowEls.forEach(el => { el.style.display = 'none'; }));
      }

      e2eTl.add(() => {}, '+=0.25'); // jeda napas sebelum tombol aktif
    }

    function resetEndToEnd() {
      e2ePhase = 0;
      buildEndToEnd();
      setE2eText(0, false);
      setE2eButton(0);
      for (let i = 1; i <= 3; i++) setPhasePill(i, 'wait');
      gsap.from('.e2e-rule-card', { y: 14, opacity: 0, duration: 0.38, stagger: 0.06, ease: 'power2.out' });
    }

    function nextEndToEndPhase() {
      if (e2eBusy) return;
      if (e2ePhase >= e2eData.length - 1) { resetEndToEnd(); return; }
      runEndToEndPhase(e2ePhase + 1);
    }

    function initEndToEnd() {
      buildEndToEnd();
      setE2eText(0, false);
      setE2eButton(0);
    }

    // Boot Application
    window.addEventListener('DOMContentLoaded', () => {
      initSlide1Animations();
      initEndToEnd();
    });
  </script>
</body>
</html>
